# Required: OpenAI API key used by the agents
OPENAI_API_KEY=

# Required: URL for the remote MCP server
MCP_SERVER_URL=

# Optional: Friendly name used in logs and MCP client setup
MCP_SERVER_NAME=User Management MCP

# Optional: Model used by the agents
MODEL=gpt-4o-mini

# Optional: Sampling temperature for model responses
MODEL_TEMPERATURE=0.2
